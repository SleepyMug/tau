{
  "name": "@sleepymug/tau",
  "version": "0.1.0",
  "description": "tau (Transportable Agent Unit): a client for agents as a service. It checks a tau, a directory that packages an agent, and a call of it, and hands the run to a wire adaptor, which carries it to a backend; and an SDK for the backends that run them",
  "type": "module",
  "bin": {
    "tau": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./transfer": {
      "types": "./dist/transfer/index.d.ts",
      "import": "./dist/transfer/index.js"
    },
    "./wire-tar": {
      "types": "./dist/wire-tar/index.d.ts",
      "import": "./dist/wire-tar/index.js"
    },
    "./adaptors": {
      "types": "./dist/adaptors/index.d.ts",
      "import": "./dist/adaptors/index.js"
    },
    "./TAU.md": "./TAU.md",
    "./TAU_DEV.md": "./TAU_DEV.md"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "TAU.md",
    "TAU_DEV.md",
    "docs/spec",
    "docs/VOCAB.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
