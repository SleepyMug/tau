{
  "name": "@sleepymug/tau",
  "version": "0.1.0",
  "description": "tau (Transportable Agent Unit): agents as directories that declare the APIs they need",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./call": {
      "types": "./dist/call/index.d.ts",
      "import": "./dist/call/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "TAU.md",
    "docs/spec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
